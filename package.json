{
  "name": "daddys-hackulator-v3",
  "version": "3.0.0",
  "description": "daddy's Lease Hackulator - Vehicle & Housing Calculator with API proxy",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "start:unified": "node server.js --mode unified",
    "start:housing": "node server.js --mode housing",
    "start:vehicle": "node server.js --mode vehicle",
    "static": "npx http-server . -p 8080 -c-1"
  },
  "dependencies": {
    "express": "^4.18.0",
    "cors": "^2.8.5"
  }
}
